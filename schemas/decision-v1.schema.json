{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://localhost/schemas/decision-v1.schema.json",
  "title": "Forex demo model proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "created_at_utc",
    "valid_until_utc",
    "symbol",
    "timeframe",
    "action",
    "confidence",
    "strategy_profile",
    "reason_code",
    "source_ids"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "valid_until_utc": {"type": "string", "format": "date-time"},
    "symbol": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,31}$"},
    "timeframe": {"const": "M5"},
    "action": {"enum": ["BUY", "SELL", "HOLD", "CLOSE", "WAIT"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "strategy_profile": {"enum": ["TREND", "MEAN_REVERSION", "NEWS_PAUSE", "NO_TRADE"]},
    "reason_code": {"type": "string", "pattern": "^[A-Z0-9_]{1,64}$"},
    "source_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 200}
    }
  }
}

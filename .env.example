# TEMPLATE ONLY: this file is not loaded by the runtime yet.
# Copy to .env for local settings. Never put .env values into chat or source control.

# Application safety gates
APP_ENV=demo
TRADING_MODE=shadow
TRADING_EXECUTION_ENABLED=false

# Broker / MT5 identity checks. Log in to MT5 Desktop manually with a Finex DEMO
# account, then use that same demo account/server in MT5 Mobile. Do not store the
# MT5 password here. Fill server/symbol only after confirming their exact names in MT5.
BROKER_NAME=FINEX
MT5_EXPECTED_ACCOUNT_MODE=demo
MT5_EXPECTED_SERVER=
MT5_SYMBOL=
MT5_TIMEFRAME=M5

# Proposed research-phase guards only; currently not consumed by the application.
MAX_OPEN_POSITIONS=1
RISK_PER_TRADE_PCT=0.10
DAILY_LOSS_LIMIT_PCT=0.50
PHASE_DRAWDOWN_LIMIT_PCT=2.00

# 9Router. The template stays disabled because no event-polling runtime is installed.
# Enabling it in a demo/shadow runtime requires MODEL_API_KEY. No hard dollar cap is
# configured; API usage may incur uncapped charges. The runtime call limit remains 5/day.
MODEL_PROVIDER_ENABLED=false
# On the Ubuntu VPS, 9Router listens on loopback. Use /v1 as the base URL;
# API routes such as /models are appended by the client.
MODEL_BASE_URL=http://127.0.0.1:20128/v1
MODEL_ID=cx/gpt-6-luna
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=10
MODEL_DAILY_CALL_LIMIT=5

# MT5 mobile push is configured manually in the terminal using the MetaQuotes ID.
# Do not put the MetaQuotes ID here.
